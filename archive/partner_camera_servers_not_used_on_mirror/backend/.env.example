SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Supabase Authentication > Users > User UID. Separate multiple owners with commas.
CAMERA_ALLOWED_USER_IDS=YOUR_USER_UUID
CAMERA_ID=1
CAMERA_NAME=Living Room Camera
# External webcam was index 1. An RTSP/HTTP camera URL is also accepted.
CAMERA_SOURCE=1
CAMERA_BACKEND=auto
MOTION_SECONDS=2
MOTION_QUIET_SECONDS=0.6
ALERT_COOLDOWN_SECONDS=30
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
# Absolute path to a server-only service-account file. Keep it outside this project.
GOOGLE_APPLICATION_CREDENTIALS=
# Bind locally when using Tailscale Serve or an HTTPS reverse proxy.
BIND_HOST=127.0.0.1
PORT=8000
