# VisionSync settings. Copy to ".env" in this folder and fill in.
#   cp .env.example .env && chmod 600 .env
# Never commit .env to git (NFR-SEC1). It is already in .gitignore.

# ---- Weather (free key: https://openweathermap.org/api -> "Current Weather Data") ----
OPENWEATHER_API_KEY=
CITY=Lahore
COUNTRY=PK
UNITS=metric
# Seconds between refreshes. SRS NFR-P2: weather every 10 minutes.
WEATHER_INTERVAL=600

# ---- Google Calendar ----
# calendar.google.com -> Settings -> your calendar -> "Integrate calendar"
# -> copy "Secret address in iCal format" and paste it here.
GOOGLE_CALENDAR_ICS_URL=
# Seconds between refreshes. SRS NFR-P2: calendar every 5 minutes.
CALENDAR_INTERVAL=300
CALENDAR_MAX_EVENTS=5

# ---- Camera / security backend (motion_stream_server.py) ----
# The SAME value must be used by the backend and by the Flutter app
# (flutter run --dart-define=MIRROR_SECRET=...). Make it long and random.
MIRROR_SECRET_KEY=
CAMERA_URL=http://127.0.0.1:8080
# Port of motion_stream_server.py (it reads this line too).
SERVER_PORT=8080
# Which webcam: auto, or a number such as 0.
CAMERA_SOURCE=auto

# Push notifications to the phone (optional). See phone_app/PUSH-SETUP.md.
# FIREBASE_SERVICE_ACCOUNT=/home/you/visionsync-firebase.json

# ---- Hub ----
# Keep 127.0.0.1: only the mirror itself can reach the hub.
HUB_HOST=127.0.0.1
HUB_PORT=8765
HUB_SOCKET=/tmp/visionsync.sock
WAKE_WORD=Hey Vision
# Glowing background: off (pure black, strongest mirror) | subtle | vivid
AMBIENT=subtle

# ---- Wi-Fi setup mode (wifi/visionsync_wifi.py) ----
# Seconds without any network before the mirror shows its Wi-Fi setup QR code.
WIFI_GRACE_SECONDS=60
WIFI_SETUP_SSID=VisionSync-Setup

# ---- Safety (SRS NFR-S1) ----
TEMP_LIMIT_C=85
TEMP_RESUME_C=75

# ---- Voice assistant (voice_assistant/) ----
# Online AI (SRS UC-2 / UC-4). With OPENAI_API_KEY set, OpenAI answers online;
# CLOUD_PROVIDER=gemini uses Gemini instead. Keys stay in this file only (NFR-SEC1).
CLOUD_PROVIDER=
OPENAI_API_KEY=
# gpt-6.1-terra: smart and fast. gpt-6-luna: about 10x cheaper.
OPENAI_MODEL=gpt-6.1-terra
# none = answer at once (best for voice); low / medium = more thinking, slower.
OPENAI_REASONING=none
# Only if doctor.py says the cloud answers only over IPv4 on your network:
# NET_FORCE_IPV4=1
# Speech to text: auto = OpenAI when online (quick, good with accents), Whisper here when offline;
# local = always on the mirror
STT_PROVIDER=auto
# Talk over Vision to make it stop: on (your voice, or Vision / stop / wait), words, off
BARGE_IN=on
# Wake phrase (said near the mirror). Add ",vision" to also wake on "Vision" alone
WAKE_WORDS=hey vision
# Seconds of silence that end your question
END_SILENCE_SECONDS=0.7
# Microphone: pipewire = the one chosen in Settings > Sound > Input
MIC_DEVICE=pipewire
# Free Gemini key (optional): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Brain on the mirror when offline (Ollama)
LOCAL_MODEL=qwen3:1.7b
# Speech to text: base.en meets the 3 s target; small.en is more accurate, about 1 s slower
WHISPER_MODEL=base.en
# Optional natural offline voice: a Piper .onnx voice (setup_voice.sh fills this in)
# PIPER_MODEL=
# Seconds of silence that end a question, and how long to wait for a follow-up
END_SILENCE_SECONDS=0.8
FOLLOWUP_SECONDS=8
# 1 = show what was heard and said in the log (off for privacy, NFR-SEC3)
VISION_DEBUG=0
# Optional: answers for the phone chat when the voice assistant is off
# ANTHROPIC_API_KEY=

# Google sync: VisionSync's own Google OAuth client secret (the Web client that Supabase uses for
# Google sign-in). It is not an account: the mirror syncs whichever Google account is connected in
# the phone app. install.sh asks for it.
GOOGLE_CLIENT_SECRET=
