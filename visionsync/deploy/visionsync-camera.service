[Unit]
Description=VisionSync camera stream + security detection
After=network.target

[Service]
Type=simple
User=visionsync
# Same .env as the hub, so MIRROR_SECRET_KEY always matches.
EnvironmentFile=/home/visionsync/visionsync/.env
WorkingDirectory=/home/visionsync/camera_backend
ExecStart=/usr/bin/python3 /home/visionsync/camera_backend/motion_stream_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
